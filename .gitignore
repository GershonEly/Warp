# ─────────────────────────────────────────────────────────────
#  SECRETS — never commit these. Warp ships with NO API keys.
# ─────────────────────────────────────────────────────────────
local.properties
secrets.properties
*.jks
*.keystore
keystore.properties
google-services.json
.env
.env.*
**/api_keys.xml
**/apikeys.xml
*.pem
*.p12
*.p8

# ─────────────────────────────────────────────────────────────
#  Toolchain — fetched from GitHub Releases, never committed
#  (~350 MB; GitHub rejects files over 100 MB)
# ─────────────────────────────────────────────────────────────
app/src/main/assets/toolchain/
app/src/main/assets/toolchain.tar.*
app/src/main/assets/toolchain.zip
toolchain/build/
toolchain/staging/
toolchain/dist/
toolchain/.cache/

# ─────────────────────────────────────────────────────────────
#  Gradle / Android build output
# ─────────────────────────────────────────────────────────────
.gradle/
build/
*/build/
**/build/
# …but a Kotlin package named "build" under src/ is SOURCE, not output.
# Without this, app/src/main/java/dev/ely/warp/build/ is silently ignored.
!**/src/**/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
release/

# ─────────────────────────────────────────────────────────────
#  IDE
# ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.kotlin/

# ─────────────────────────────────────────────────────────────
#  Screenshots — kept locally, never committed
# ─────────────────────────────────────────────────────────────
docs/screenshots/*
!docs/screenshots/README.md
Screenshot_*.jpg
Screenshot_*.png

# ─────────────────────────────────────────────────────────────
#  OS
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
#  Logs / temp
# ─────────────────────────────────────────────────────────────
*.log
*.hprof
tmp/
temp/
