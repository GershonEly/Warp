    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M68.99,45.35 L54.00,71.30 M68.99,45.35 L39.01,45.35 M68.99,45.35 L54.00,26.00 M68.99,45.35 L78.25,68.00 M68.99,45.35 L78.25,40.00 M54.00,71.30 L39.01,45.35 M54.00,71.30 L54.00,82.00 M54.00,71.30 L29.75,68.00 M54.00,71.30 L78.25,68.00 M39.01,45.35 L29.75,40.00 M39.01,45.35 L29.75,68.00 M39.01,45.35 L54.00,26.00 M54.00,82.00 L29.75,68.00 M54.00,82.00 L78.25,68.00 M54.00,82.00 L39.01,62.65 M54.00,82.00 L68.99,62.65 M29.75,40.00 L29.75,68.00 M29.75,40.00 L54.00,26.00 M29.75,40.00 L39.01,62.65 M29.75,40.00 L54.00,36.70 M29.75,68.00 L39.01,62.65 M54.00,26.00 L78.25,40.00 M54.00,26.00 L54.00,36.70 M78.25,68.00 L78.25,40.00 M78.25,68.00 L68.99,62.65 M78.25,40.00 L54.00,36.70 M78.25,40.00 L68.99,62.65 M39.01,62.65 L54.00,36.70 M39.01,62.65 L68.99,62.65 M54.00,36.70 L68.99,62.65">

