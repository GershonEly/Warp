    "_resolved_from": "androidx.compose:compose-bom:2026.06.01 + activity-compose:1.13.0, as resolved by Gradle for Warp's own app. Regenerate with the pinCompose init script when those versions move.",
    "license": "Apache-2.0",
    "google_maven": "https://dl.google.com/dl/android/maven2",
    "maven_central": "https://repo1.maven.org/maven2",
